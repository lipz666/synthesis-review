# Local defaults are fine; every value below is optional.

# Where ingested datasets and the catalog live (mount a volume here in the cloud).
REVIEW_DATA_DIR=/srv/review/data
# Static frontend directory (serve from a CDN instead and point the API elsewhere).
REVIEW_STATIC_DIR=/srv/review/static

# Public URL prefix for dataset assets. Point at a bucket/CDN to stop serving
# images from this process.
REVIEW_ASSET_URL_PREFIX=/review-data/datasets

# Event store. Default: sqlite:///$REVIEW_DATA_DIR/review.sqlite3
# REVIEW_DATABASE_URL=postgresql://user:pass@host:5432/review

# Reviewer identity (MVP: the browser supplies a name, this is the fallback).
REVIEW_DEFAULT_REVIEWER=anonymous
# Set to 1 to refuse events from unnamed reviewers.
REVIEW_REQUIRE_REVIEWER=0

# Needed only when the frontend is served from a different origin than the API.
# REVIEW_CORS_ORIGINS=https://review.example.com

REVIEW_ASSET_MAX_AGE=86400

# --- submission intake -------------------------------------------------
# Ingest is the only endpoint that writes to the data directory. Set a token
# before this app is reachable by anyone untrusted.
# REVIEW_INGEST_TOKEN=change-me
REVIEW_INGEST_ENABLED=1
REVIEW_INGEST_MAX_BYTES=536870912
REVIEW_INGEST_MAX_UNCOMPRESSED_BYTES=2147483648
REVIEW_INGEST_MAX_ENTRIES=20000
